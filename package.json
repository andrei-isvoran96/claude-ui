{
  "name": "claude-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Electron desktop wrapper for Claude Code with a built-in terminal and session history.",
  "author": "aisvoran",
  "main": "dist-electron/main.js",
  "bin": {
    "claude-ui": "./bin/claude-ui.sh"
  },
  "scripts": {
    "postinstall": "npm run rebuild-pty",
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .",
    "build:mac-icon": "node ./scripts/build-mac-icon.cjs",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "start": "npm run build && NODE_ENV=production electron .",
    "rebuild-pty": "electron-builder install-app-deps",
    "dist": "npm run dist:mac:arm64",
    "dist:mac:arm64": "npm run build:mac-icon && npm run build && electron-builder --mac dmg zip --arm64"
  },
  "build": {
    "appId": "com.claudeui.app",
    "productName": "Claude UI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "dmg": {
      "title": "Claude UI"
    },
    "npmRebuild": true
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  }
}
